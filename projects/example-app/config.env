# ==========================================
# PROJECT IDENTITY
# ==========================================
APP_NAME="example-app"
DESCRIPTION="An example python app"
PYTHON_BIN="python3"

# ==========================================
# DIRECTORY STRUCTURE
# ==========================================
# Use "app" or "src" if your code is nested.
# Use "." if your main.py and requirements.txt are in the root.
APP_DIR="app"

# ==========================================
# NETWORK CONFIGURATION
# ==========================================
# "true": PORT must be set in .env and must be free before starting.
# "false": background scripts/bots that don't listen on a port.
# This example only prints to the log, so it needs no port.
REQUIRE_PORT="false"

# ==========================================
# RUNNER CONFIGURATION (Select One)
# ==========================================

# --- OPTION 1: Standard Python Script ---
ENTRYPOINT="python"
ARGS="main.py"

# --- OPTION 2: Uvicorn (FastAPI) ---
# ENTRYPOINT="uvicorn"
# ARGS="main:app --host 0.0.0.0 --port $PORT"

# --- OPTION 3: Gunicorn (WSGI) ---
# ENTRYPOINT="gunicorn"
# ARGS="wsgi:app --bind 0.0.0.0:$PORT"