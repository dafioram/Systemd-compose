#!/bin/bash
# Lists the TCP ports recorded in the fake systemctl state directory.
requested_port="${*: -1}"
requested_port="${requested_port##*:}"
if [ -f "${STUB_STATE:?}/ports" ]; then
    while read -r port owner; do
        [ "$port" == "$requested_port" ] || continue
        printf 'LISTEN 0 128 0.0.0.0:%s 0.0.0.0:*' "$port"
        if [[ "$*" == *-ltnp* && "$owner" == sdc-* ]]; then
            printf ' users:(("fake",pid=%s,fd=3))' "$PPID"
        fi
        printf '\n'
    done < "$STUB_STATE/ports"
fi
