# --- App Identity ---
APP_NAME="my-awesome-app"
APP_DESCRIPTION="An awesome Service"

# --- Runtime ---
APP_RUNTIME="python"
VENV_DIR=".venv"

# --- Execution Command ---
# {{VENV}} expands to venv/bin
EXEC_CMD="{{VENV}}/uvicorn main:app"

# --- systemd ---
SYSTEMD_MODE="user"      # user | system
ENABLE_LINGER="auto"
