# =========================================================
# GLOBAL CONFIGURATION
# Copy this to .env to activate: cp .env.example .env
# =========================================================

# [APPS_ROOT]
# Defines the directory where 'app-ctl ps' looks for projects.
# Default (if empty): Looks in ~/app-ctl/projects/
#
# Example:
# APPS_ROOT="$HOME/Development/my-bots"